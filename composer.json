{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^11.0",
        "laravel/reverb": "^1.10",
        "laravel/sanctum": "^4.0",
        "laravel/telescope": "^5.20",
        "laravel/tinker": "^2.9",
        "meilisearch/meilisearch-php": "^1.16",
        "open-telemetry/exporter-otlp": "*",
        "open-telemetry/sdk": "*",
        "phpoffice/phpspreadsheet": "^5.8",
        "pusher/pusher-php-server": "^7.2",
        "spatie/laravel-permission": "^6.25"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "2.9",
        "laravel/octane": "*",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpstan/phpstan-strict-rules": "^1.6",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^1.2",
        "spatie/laravel-ignition": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/helpers.php",
            "app/helpers/site-setting.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit",
        "test:feature": "@php vendor/bin/phpunit tests/Feature",
        "test:unit": "@php vendor/bin/phpunit tests/Unit",
        "phpstan": "php -d memory_limit=2G vendor/bin/phpstan analyse --memory-limit=2G",
        "phpstan:lite": "php -d memory_limit=2G vendor/bin/phpstan analyse --memory-limit=2G --level=3",
        "phpstan:ci": "php -d memory_limit=2G vendor/bin/phpstan analyse --no-progress --error-format=github --memory-limit=2G",
        "phpstan:baseline": "php -d memory_limit=2G vendor/bin/phpstan analyse --memory-limit=2G --generate-baseline --allow-empty-baseline",
        "pint": "vendor/bin/pint",
        "pint:fix": "vendor/bin/pint",
        "pint:test": "vendor/bin/pint --test",
        "rector": "php -d memory_limit=1G vendor/bin/rector process --dry-run --clear-cache",
        "rector:fix": "php -d memory_limit=1G vendor/bin/rector process --clear-cache",
        "quality": [
            "@pint:test",
            "@phpstan"
        ],
        "quality:lite": [
            "@pint:test",
            "@phpstan:lite"
        ],
        "quality:fix": [
            "@pint:fix"
        ],
        "ide-helper": [
            "php -d memory_limit=1G artisan ide-helper:generate",
            "php -d memory_limit=1G artisan ide-helper:models --write-mixin"
        ],
        "ide-helper:clear": "php artisan ide-helper:clear",
        "quality:ci": [
            "@pint:test",
            "@phpstan:ci"
        ],
        "quality:full": [
            "@pint:fix",
            "@rector:fix",
            "@phpstan:baseline",
            "@phpstan"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "php -d memory_limit=1G artisan ide-helper:generate 2>/dev/null || true",
            "php -d memory_limit=1G artisan ide-helper:models --write-mixin 2>/dev/null || true",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --ansi"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-master": "11.x-dev"
        },
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
