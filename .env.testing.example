# PHPUnit / artisan test 专用（复制为 .env.testing 并按本地 PG 修改密码）
# DB_DATABASE 必须与 phpunit.xml 中 hwut_test 一致，勿使用生产库 huwutong

APP_ENV=testing
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hwut_test
DB_USERNAME=postgres
DB_PASSWORD=

CACHE_STORE=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
TELESCOPE_ENABLED=false
