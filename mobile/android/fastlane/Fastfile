# D-29: Fastlane 配置 — Android 分发
#
# 前提：
#   - 在 Google Play Console 创建项目并上传第一版 AAB
#   - 设置 Service Account 并下载 JSON 密钥
#   - 设置环境变量:
#     - SUPPLY_JSON_KEY_DATA: Base64 编码的 Service Account JSON
#     - ANDROID_KEYSTORE_FILE / ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD

default_platform(:android)

platform :android do
  desc "构建并上传 Release AAB 到 Google Play 内部测试轨道"
  lane :deploy_internal do
    gradle(
      task: 'bundle',
      build_type: 'Release',
      print_command: true,
    )

    supply(
      track: 'internal',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: false,
    )
  end

  desc "构建并上传 Release AAB 到 Google Play Alpha/Beta 轨道"
  lane :deploy_beta do
    gradle(
      task: 'bundle',
      build_type: 'Release',
      print_command: true,
    )

    supply(
      track: 'beta',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: false,
    )
  end

  desc "构建 Debug APK（快速验证）"
  lane :build_debug do
    gradle(
      task: 'assemble',
      build_type: 'Debug',
    )
  end

  desc "构建并上传 Release AAB 到 Google Play 正式版轨道"
  lane :deploy_production do
    gradle(
      task: 'bundle',
      build_type: 'Release',
      print_command: true,
    )

    supply(
      track: 'production',
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: false,
    )
  end
end
