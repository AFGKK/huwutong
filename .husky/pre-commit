#!/bin/sh
# ============================================================
# Pre-commit Git Hook - 代码质量检查
# M0-08: 拦截低质量提交
#
# 由 husky 管理，不要手动编辑此文件
# 安装: npx husky install
# ============================================================

. "$(dirname "$0")/_/husky.sh"

echo ""
echo "════════════════════════════════════════"
echo "  代码质量检查 - Pre-commit Hook"
echo "════════════════════════════════════════"

# 收集暂存区 PHP 文件
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.php$' || true)
STAGED_JS=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(vue|js|ts)$' || true)

HAS_ERRORS=0

# ─── 1. Laravel Pint 代码风格检查 ───
if [ -n "$STAGED_PHP" ]; then
    echo ""
    echo "📐 [1/3] Laravel Pint 代码风格检查..."
    echo "    涉及 $(echo "$STAGED_PHP" | wc -l) 个 PHP 文件"

    # 检查模式（不改文件，仅报告差异）
    if ! vendor/bin/pint --test "$STAGED_PHP" 2>/dev/null; then
        echo "  ⚠️  存在代码风格问题"
        echo "  运行 vendor/bin/pint 自动修复"
        echo "  或运行: composer pint:fix"
        vendor/bin/pint "$STAGED_PHP" 2>/dev/null || true
        git add $STAGED_PHP 2>/dev/null || true
        echo "  ✅ 已自动修复并重新暂存"
    else
        echo "  ✅ 代码风格通过"
    fi
fi

# ─── 2. PHPStan 静态分析（仅暂存文件） ───
if [ -n "$STAGED_PHP" ]; then
    echo ""
    echo "🔍 [2/3] PHPStan 静态分析..."
    echo "    分析 $(echo "$STAGED_PHP" | wc -l) 个 PHP 文件"

    # 以列表形式传递暂存文件
    ANALYSIS_FILES=$(echo "$STAGED_PHP" | tr '\n' ' ')
    if ! vendor/bin/phpstan analyse --no-progress --error-format=raw $ANALYSIS_FILES 2>&1; then
        echo "  ❌ PHPStan 检测到错误，请修复后重新提交"
        HAS_ERRORS=1
    else
        echo "  ✅ 静态分析通过"
    fi
fi

# ─── 3. 安全检查 - 硬编码密钥泄露 ───
echo ""
echo "🔒 [3/3] 密钥泄露扫描..."

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR || true)
KEY_PATTERNS='sk_live_|pk_live_|AKIA[0-9A-Z]{16}|-----BEGIN RSA PRIVATE KEY-----|-----BEGIN OPENSSH PRIVATE KEY-----|ghp_[a-zA-Z0-9]{36}|gho_[a-zA-Z0-9]{36}|xox[bpsa]-[0-9]{12}-[0-9]{12}'

LEAKS_FOUND=0
for FILE in $STAGED_FILES; do
    if [ -f "$FILE" ]; then
        LEAKS=$(grep -E "$KEY_PATTERNS" "$FILE" 2>/dev/null || true)
        if [ -n "$LEAKS" ]; then
            echo "  ❌ 检测到可能的密钥泄露: $FILE"
            echo "$LEAKS" | sed 's/^/      /'
            LEAKS_FOUND=$((LEAKS_FOUND + 1))
        fi
    fi
done

if [ $LEAKS_FOUND -gt 0 ]; then
    echo "  ❌ 发现 $LEAKS_FOUND 个文件包含疑似密钥，已阻断提交"
    echo "  请移除密钥或使用环境变量替代"
    HAS_ERRORS=1
else
    echo "  ✅ 未检测到密钥泄露"
fi

# ─── 总结 ───
echo ""
echo "════════════════════════════════════════"
if [ $HAS_ERRORS -eq 0 ]; then
    echo "  ✅ 所有代码质量检查通过"
else
    echo "  ❌ 代码质量检查未通过，提交已阻断"
    echo "  请修复上述错误后重新提交"
fi
echo "════════════════════════════════════════"
echo ""

exit $HAS_ERRORS
