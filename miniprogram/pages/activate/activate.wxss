/* 激活页 */
.page {
  min-height: 100vh;
  padding: 16px 16px calc(24px + env(safe-area-inset-bottom));
  background: #f7f8fa;
  box-sizing: border-box;
}

.form-card {
  padding: 20px 16px;
}

.header {
  text-align: center;
  padding: 4px 0 16px;
}

.header-title {
  font-size: 20px;
  font-weight: 600;
  color: #1f1f1f;
}

.header-sub {
  font-size: 13px;
  color: #5f6368;
  margin-top: 6px;
  display: block;
}

.key-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14px;
  background: #f0f7ff;
  border-radius: 12px;
  margin-bottom: 20px;
}

.key-label {
  font-size: 12px;
  color: #9aa0a6;
  margin-bottom: 4px;
}

.key-value {
  font-size: 14px;
  font-weight: 600;
  color: #1a73e8;
  text-align: center;
}

.form-group {
  margin-bottom: 16px;
}

.form-label {
  display: block;
  font-size: 14px;
  color: #1f1f1f;
  margin-bottom: 6px;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 44px;
  background: #f0f2f5;
  border-radius: 12px;
  padding: 0 14px;
  font-size: 15px;
  box-sizing: border-box;
}

.form-placeholder {
  color: #9aa0a6;
}

.form-hint {
  display: block;
  margin-top: 6px;
  font-size: 11px;
  color: #9aa0a6;
  line-height: 1.4;
}

.fingerprint-display {
  width: 100%;
  padding: 12px 14px;
  background: #f0f2f5;
  border-radius: 12px;
  box-sizing: border-box;
}

.fingerprint-text {
  font-size: 12px;
  color: #5f6368;
  word-break: break-all;
}

.actions {
  margin-top: 20px;
  display: flex;
  flex-direction: column;
}

.btn {
  width: 100%;
  height: 46px;
  line-height: 46px;
  text-align: center;
  font-size: 16px;
  border-radius: 12px;
  border: none;
  margin-bottom: 10px;
}

.btn::after {
  border: none;
}

.btn:active {
  opacity: 0.85;
}

.btn-primary {
  background: #1a73e8;
  color: #ffffff;
}

.btn-primary.loading {
  opacity: 0.75;
}

.btn-outline {
  background: #ffffff;
  color: #1a73e8;
  border: 1px solid #1a73e8;
}

.btn-secondary {
  background: transparent;
  color: #5f6368;
}

.btn-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 46px;
}

.spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  margin-right: 8px;
  animation: hwt-spin 0.7s linear infinite;
}

@keyframes hwt-spin {
  to { transform: rotate(360deg); }
}

.tips {
  margin-top: 20px;
  padding: 14px 16px;
  background: #fff8e6;
  border-radius: 12px;
}

.tips-title {
  font-size: 13px;
  font-weight: 600;
  color: #ad6800;
  margin-bottom: 6px;
  display: block;
}

.tips-text {
  display: block;
  font-size: 12px;
  color: #8c6d1f;
  line-height: 1.75;
}

/* 成功态 */
.success-page {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 48px;
}

.success-card {
  width: 100%;
  padding: 36px 20px 24px;
  text-align: center;
  box-sizing: border-box;
}

.success-icon {
  width: 64px;
  height: 64px;
  margin: 0 auto 16px;
  border-radius: 50%;
  background: #e6f4ea;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: hwt-pop 0.35s ease-out;
}

.success-check {
  width: 18px;
  height: 10px;
  border-left: 3px solid #34a853;
  border-bottom: 3px solid #34a853;
  transform: rotate(-45deg);
  margin-top: -4px;
}

@keyframes hwt-pop {
  from { transform: scale(0.6); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.success-title {
  display: block;
  font-size: 20px;
  font-weight: 600;
  color: #1f1f1f;
  margin-bottom: 8px;
}

.success-desc {
  display: block;
  font-size: 14px;
  color: #5f6368;
  margin-bottom: 12px;
}

.success-key {
  display: block;
  font-size: 12px;
  color: #9aa0a6;
  margin-bottom: 28px;
  word-break: break-all;
}

.success-actions {
  display: flex;
  flex-direction: column;
}
