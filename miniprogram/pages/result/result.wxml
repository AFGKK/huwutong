<!-- 结果页：大状态 + 关键指标 + 主次操作 -->
<view class="page" wx:if="{{license}}">
  <view class="status-header" style="background-color: {{statusColor}};">
    <view class="status-badge">{{statusLabel}}</view>
    <text class="license-key hwt-key">{{license.license_key}}</text>
    <view class="copy-btn" bindtap="onCopyKey"><text>复制 Key</text></view>
  </view>

  <!-- 关键数字 -->
  <view class="card metrics">
    <view class="metric">
      <text class="metric-label">产品</text>
      <text class="metric-value">{{license.product_name || '—'}}</text>
    </view>
    <view class="metric-divider"></view>
    <view class="metric">
      <text class="metric-label">到期</text>
      <text class="metric-value {{isExpired ? 'danger' : ''}}">{{expiresAtText}}</text>
    </view>
    <view class="metric-divider"></view>
    <view class="metric">
      <text class="metric-label">设备</text>
      <text class="metric-value">{{license.activated_devices || 0}}/{{license.max_devices || '∞'}}</text>
    </view>
  </view>

  <!-- 详情（折叠感：少行） -->
  <view class="card info-card">
    <view class="info-row">
      <text class="info-label">授权类型</text>
      <text class="info-value">{{license.license_type_label || license.license_type || '—'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">激活状态</text>
      <text class="info-value">{{license.activated ? '已激活' : '未激活'}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">创建时间</text>
      <text class="info-value">{{createdAtText}}</text>
    </view>
    <view class="info-row" wx:if="{{license.product_description}}">
      <text class="info-label">产品说明</text>
      <text class="info-value secondary">{{license.product_description}}</text>
    </view>
  </view>

  <!-- 状态说明（短文案） -->
  <view class="card guide-card" wx:if="{{guideSummary}}">
    <text class="guide-text">{{guideSummary}}</text>
  </view>

  <!-- 主操作区 -->
  <view class="actions">
    <button class="btn btn-primary" bindtap="onActivate" wx:if="{{canActivate}}">
      激活设备
    </button>
    <button class="btn btn-primary" bindtap="onPrimaryRenew" wx:elif="{{guideType === 'expired'}}">
      去续费
    </button>
    <button class="btn btn-primary" open-type="contact" session-from="license-{{guideType}}" wx:elif="{{guideType === 'suspended' || guideType === 'revoked'}}">
      联系客服
    </button>

    <button class="btn btn-outline" bindtap="onSubscribeExpiry" wx:if="{{canSubscribe}}" disabled="{{subscribeBusy}}">
      {{subscribeBusy ? '处理中...' : '订阅过期提醒'}}
    </button>

    <view class="secondary-row">
      <button class="btn-link" open-type="share">分享</button>
      <button class="btn-link" open-type="contact" session-from="license-result-actions">客服</button>
      <button class="btn-link" bindtap="onOpenHelp">帮助</button>
      <button class="btn-link" bindtap="onNewQuery">再查</button>
    </view>
  </view>

  <view class="section" wx:if="{{devices.length > 0}}">
    <view class="section-title">已激活设备</view>
    <view class="card device-list">
      <view class="device-item" wx:for="{{devices}}" wx:key="id">
        <view class="device-main">
          <text class="device-name">{{item.device_name || item.platform || '未命名设备'}}</text>
          <text class="device-meta">{{item.platform || '—'}} · {{item.fingerprint_mask}}</text>
        </view>
        <text class="device-time">{{item.last_seen_at || ''}}</text>
      </view>
    </view>
  </view>
</view>

<view class="page empty" wx:else>
  <text class="empty-text">暂无数据，请返回重新查询</text>
  <button class="btn btn-outline" bindtap="onNewQuery">返回查询</button>
</view>
