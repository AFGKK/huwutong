.page {
  min-height: 100vh;
  background: #f5f5f5;
}

.fallback {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48px 24px;
  box-sizing: border-box;
}

.title {
  font-size: 16px;
  font-weight: 600;
  color: #1f1f1f;
  margin-bottom: 10px;
}

.hint {
  font-size: 13px;
  color: #5f6368;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 16px;
}

.url {
  font-size: 12px;
  color: #9aa0a6;
  word-break: break-all;
  text-align: center;
  margin-bottom: 20px;
}

.btn {
  width: 80%;
  background: #1a73e8;
  color: #ffffff;
  border-radius: 22px;
  font-size: 14px;
  border: none;
  margin-bottom: 12px;
}

.btn::after {
  border: none;
}

.btn.ghost {
  background: #ffffff;
  color: #1a73e8;
  border: 1px solid #1a73e8;
}
