.page {
  min-height: 100vh;
  padding: 20px 16px calc(40px + env(safe-area-inset-bottom));
  background: #f7f8fa;
  box-sizing: border-box;
}

.title {
  font-size: 20px;
  font-weight: 600;
  color: #1f1f1f;
  margin-bottom: 16px;
}

.p {
  display: block;
  font-size: 14px;
  color: #5f6368;
  line-height: 1.8;
  margin-bottom: 12px;
}

.hint {
  margin-top: 24px;
  font-size: 12px;
  color: #9aa0a6;
  word-break: break-all;
}

.btn {
  margin-top: 16px;
  background: #1a73e8;
  color: #ffffff;
  border-radius: 22px;
  font-size: 15px;
  border: none;
}

.btn::after {
  border: none;
}
