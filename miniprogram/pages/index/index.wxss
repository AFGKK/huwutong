/* 查询页 */
.page {
  min-height: 100vh;
  padding: 0 16px calc(40px + env(safe-area-inset-bottom));
  background: #f7f8fa;
  box-sizing: border-box;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 0 20px;
}

.brand-mark {
  width: 56px;
  height: 56px;
  line-height: 56px;
  text-align: center;
  background: #1a73e8;
  color: #ffffff;
  font-size: 24px;
  font-weight: 700;
  border-radius: 16px;
  margin-bottom: 14px;
  box-shadow: 0 6px 16px rgba(26, 115, 232, 0.28);
}

.title {
  font-size: 20px;
  font-weight: 600;
  color: #1f1f1f;
}

.subtitle {
  font-size: 13px;
  color: #5f6368;
  margin-top: 6px;
}

.search-card {
  margin-top: 4px;
  padding: 16px;
}

.search-row {
  display: flex;
  align-items: center;
  background: #f0f2f5;
  border-radius: 12px;
  padding: 0 8px 0 12px;
}

.search-input {
  flex: 1;
  height: 46px;
  font-size: 15px;
  background: transparent;
}

.placeholder {
  color: #9aa0a6;
}

.search-actions {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.action-btn {
  padding: 8px 10px;
}

.action-btn:active {
  opacity: 0.7;
}

.action-text {
  font-size: 13px;
  color: #1a73e8;
  font-weight: 500;
}

.action-text.muted {
  color: #9aa0a6;
  font-weight: 400;
}

.lookup-btn {
  width: 100%;
  height: 46px;
  margin-top: 12px;
  line-height: 46px;
  text-align: center;
  background: #1a73e8;
  color: #ffffff;
  font-size: 16px;
  font-weight: 500;
  border-radius: 12px;
  border: none;
}

.lookup-btn::after {
  border: none;
}

.lookup-btn:active {
  opacity: 0.85;
}

.lookup-btn.loading {
  opacity: 0.85;
}

.btn-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 46px;
}

.spinner {
  width: 16px;
  height: 16px;
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-top-color: #ffffff;
  border-radius: 50%;
  margin-right: 8px;
  animation: hwt-spin 0.7s linear infinite;
}

@keyframes hwt-spin {
  to { transform: rotate(360deg); }
}

.hint {
  margin-top: 12px;
  padding: 0 4px;
}

.hint-text {
  font-size: 12px;
  color: #9aa0a6;
  line-height: 1.5;
}

.examples {
  margin-top: 20px;
  padding: 0 4px;
}

.examples-label {
  display: block;
  font-size: 12px;
  color: #9aa0a6;
  margin-bottom: 8px;
}

.examples-list {
  display: flex;
  flex-wrap: wrap;
}

.example-chip {
  font-size: 11px;
  color: #5f6368;
  background: #eeeeee;
  padding: 6px 10px;
  border-radius: 8px;
  margin-right: 8px;
  margin-bottom: 8px;
}

.example-chip:active {
  background: #d8d8d8;
}

.section {
  margin-top: 28px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
  padding: 0 4px;
}

.section-title {
  font-size: 13px;
  font-weight: 500;
  color: #5f6368;
}

.section-action {
  font-size: 12px;
  color: #1a73e8;
}

.recent-list {
  overflow: hidden;
}

.recent-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 16px;
  border-bottom: 1px solid #f0f0f0;
}

.recent-item:last-child {
  border-bottom: none;
}

.recent-item:active {
  background: #f5f5f5;
}

.recent-key {
  font-size: 13px;
  color: #1f1f1f;
  max-width: 85%;
}

.recent-arrow {
  color: #9aa0a6;
  font-size: 18px;
}

.empty-recent {
  text-align: center;
  padding-top: 8px;
}

.empty-hint {
  font-size: 12px;
  color: #9aa0a6;
}
