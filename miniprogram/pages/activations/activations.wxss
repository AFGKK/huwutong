.page {
  min-height: 100vh;
  padding: 16px 16px calc(24px + env(safe-area-inset-bottom));
  background: #f7f8fa;
  box-sizing: border-box;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 72px;
}

.empty-icon {
  width: 48px;
  height: 48px;
  line-height: 48px;
  text-align: center;
  border-radius: 14px;
  background: #e8f0fe;
  color: #1a73e8;
  font-size: 16px;
  font-weight: 600;
  margin-bottom: 14px;
}

.empty-icon.muted {
  background: #eeeeee;
  color: #9aa0a6;
}

.empty-text {
  font-size: 15px;
  color: #5f6368;
  margin-bottom: 8px;
}

.empty-hint {
  font-size: 12px;
  color: #9aa0a6;
  text-align: center;
  margin-bottom: 16px;
  padding: 0 24px;
  line-height: 1.5;
}

.btn {
  background: #1a73e8;
  color: #ffffff;
  border-radius: 22px;
  font-size: 14px;
  border: none;
  padding: 0 28px;
}

.btn::after {
  border: none;
}

.skeleton-wrap {
  padding-top: 4px;
}

.skeleton-card {
  padding: 16px;
  margin-bottom: 12px;
}

.sk-line {
  height: 12px;
  border-radius: 6px;
  background: #eceff3;
  margin-bottom: 10px;
  animation: hwt-pulse 1.2s ease-in-out infinite;
}

.sk-w60 { width: 60%; }
.sk-w90 { width: 90%; }
.sk-w40 { width: 40%; margin-bottom: 0; }

@keyframes hwt-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

.card {
  background: #ffffff;
  border-radius: 12px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.05);
  padding: 14px 16px;
  margin-bottom: 12px;
}

.item:active {
  opacity: 0.85;
}

.row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.product {
  font-size: 15px;
  font-weight: 600;
  color: #1f1f1f;
}

.status {
  font-size: 12px;
  color: #34a853;
}

.status.expired {
  color: #ea4335;
}

.key {
  display: block;
  font-size: 12px;
  color: #5f6368;
  margin-top: 8px;
}

.row-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 10px;
  font-size: 12px;
  color: #9aa0a6;
}

.exp {
  display: block;
  font-size: 12px;
  color: #9aa0a6;
  margin-top: 6px;
}
