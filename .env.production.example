# ─── 互物通生产环境模板（P0 / D-01~D-04） ───
# 复制为服务器 .env 后填入真实凭据；完整步骤见 docs/生产部署方案.md
# HTTPS 专篇: docs/deploy-https.md
# 一键写入（Windows）: powershell -File scripts/apply-production-https.ps1 -Domain 88.huwutong.com
# 发布后验收: php scripts/verify-production.php
#
# 【切勿提交真实密钥】支付私钥、短信 AK、微信 AppSecret、FCM JSON 仅存服务器 .env / 系统设置

APP_NAME="HWT License"
APP_ENV=production
# 部署后执行: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Shanghai
APP_URL=https://88.huwutong.com

# Nginx / 负载均衡终止 TLS 后，Laravel 需信任代理头
FORCE_HTTPS=true
TRUSTED_PROXIES=*

# ─── Session / Cookie（HTTPS 必须） ───
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=.huwutong.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ─── Sanctum SPA 域（无协议、无路径；逗号分隔） ───
# 含主站、管理后台、门户、局域网调试（可选）
SANCTUM_STATEFUL_DOMAINS=88.huwutong.com,www.huwutong.com,admin.huwutong.com,portal.huwutong.com,localhost:5173

FRONTEND_URL=https://88.huwutong.com
CORS_ALLOWED_ORIGINS=https://88.huwutong.com,https://www.huwutong.com,https://portal.huwutong.com

# ─── Reverb WebSocket（Nginx 反代 /app → 127.0.0.1:8080） ───
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=hwt-prod
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=88.huwutong.com
REVERB_PORT=443
REVERB_SCHEME=https

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── WebRTC ICE / TURN（D-09，跨网段/4G 通话需配置 TURN） ───
# ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.88.huwutong.com:3478","username":"hwt","credential":"YOUR_TURN_SECRET"}]'
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
WEBRTC_TURN_URL=turn:turn.88.huwutong.com:3478
WEBRTC_TURNS_URL=turns:turn.88.huwutong.com:5349
WEBRTC_TURN_USERNAME=hwt
WEBRTC_TURN_CREDENTIAL=

# ─── 队列 / 缓存 ───
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ─── 数据库（按实际环境填写） ───
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=huwutong
DB_USERNAME=postgres
DB_PASSWORD=

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ─── 支付（D-03） ───
PAYMENT_DRIVER=alipay
ALIPAY_ENABLED=true
ALIPAY_SANDBOX=false
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY=
# ALIPAY_NOTIFY_URL=https://88.huwutong.com/api/payment/alipay/webhook
# ALIPAY_RETURN_URL=https://88.huwutong.com/portal/orders
# STRIPE_ENABLED=false
# STRIPE_SECRET=
# STRIPE_WEBHOOK_SECRET=

# ─── 微信支付（D-03，可选，V3 API） ───
# WECHAT_APP_ID=
# WECHAT_MCH_ID=
# WECHAT_PAY_KEY=
# WECHAT_PAY_SERIAL_NO=         # 商户 API 证书序列号（用于 V3 签名）
# WECHAT_PAY_PRIVATE_KEY=       # 商户 API v3 密钥（RSA 私钥 PEM 内容，需换行为 \n）

# ─── 邮件 / 短信（D-04） ───
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@huwutong.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_ADMIN_ADDRESS=admin@huwutong.com

SMS_DRIVER=aliyun
SMS_FALLBACK_TO_LOG=false
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=互物通
# ALIYUN_SMS_TEMPLATE_CODE=

# ─── 可选：搜索 / 本地 LLM ───
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_API_KEY=
# LOCAL_LLM_ENABLED=false

# ─── Flutter FCM 推送（D-28，真机联调必填） ───
# Firebase Console → 服务账号 → 生成私钥 JSON → storage/app/fcm-credentials.json
# FCM_PROJECT_ID=your-firebase-project-id
# FCM_CREDENTIALS_PATH=/var/www/huwutong/storage/app/fcm-credentials.json
# FCM_DRY_RUN=false
# 验收: php artisan fcm:test-push admin@example.com --dry-run

# ─── 微信小程序（D-31，也可在管理后台「系统设置」填写） ───
# WECHAT_MINI_PROGRAM_APPID=wxXXXXXXXXXXXXXXXX
# WECHAT_MINI_PROGRAM_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 同步到 miniprogram/: php scripts/sync-miniprogram-config.php
