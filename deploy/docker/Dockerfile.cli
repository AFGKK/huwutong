FROM php:8.3-cli-alpine

RUN apk add --no-cache \
    git \
    unzip \
    curl \
    bash \
    oniguruma-dev \
    libzip-dev \
    libxml2-dev \
    libsodium-dev \
    postgresql-dev \
    linux-headers \
    && docker-php-ext-install -j$(nproc) \
    pdo_mysql \
    pdo_pgsql \
    mbstring \
    bcmath \
    zip \
    xml \
    sodium \
    pcntl \
    && pecl install redis \
    && docker-php-ext-enable redis

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www

COPY deploy/docker/entrypoint-cli.sh /usr/local/bin/entrypoint-cli.sh
RUN chmod +x /usr/local/bin/entrypoint-cli.sh

ENTRYPOINT ["entrypoint-cli.sh"]
CMD ["php", "artisan", "queue:work", "redis", "--sleep=3", "--tries=3", "--max-time=3600"]
