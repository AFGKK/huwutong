# ===================================================
# .env.airgap.mysql — MySQL 遗留离线环境
# 配合 docker-compose.mysql.yml 使用
# ===================================================
APP_NAME="HWT License (Air-Gapped MySQL)"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=huwutong
DB_USERNAME=huwutong
DB_PASSWORD=HwtRoot2024!

REDIS_HOST=redis
REDIS_PASSWORD=HwtRedis2024!
REDIS_PORT=6379

QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
CACHE_STORE=file
SESSION_DRIVER=file

LICENSE_IMPORT_DIR=/app/licenses
LICENSE_AUTO_VERIFY=true

SANCTUM_STATEFUL_DOMAINS=localhost:8000
SESSION_SECURE_COOKIE=false

AIR_GAPPED_MODE=true
DISABLE_TELEMETRY=true
DISABLE_UPDATE_CHECK=true
OFFLINE_LICENSE_PATH=

MYSQLDUMP_PATH=mysqldump
