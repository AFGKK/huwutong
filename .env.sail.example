# ─── Sail Docker 开发环境 ───
# 本文件是 .env 中 Sail 相关配置的参考模板。
# compose.yaml 已配置以下服务: MySQL 8.4, Redis, Mailpit

# ─── Laravel 基础 ───
APP_DEBUG=true
APP_TIMEZONE=Asia/Shanghai

# ─── 数据库（Docker MySQL 容器） ───
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=huwutong
DB_USERNAME=sail
DB_PASSWORD=password

# ─── Redis（Docker Redis 容器） ───
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ─── 邮件（Docker Mailpit 容器） ───
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025

# ─── 端口映射 ───
# 主机端口 : 容器端口
APP_PORT=80              # 应用: http://localhost
FORWARD_DB_PORT=3306     # MySQL
FORWARD_REDIS_PORT=6379  # Redis
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025  # Mailpit UI: http://localhost:8025

# ─── WWW 用户 ───
# Windows: 保持 1000:1000
# Linux/macOS: 使用 id -u 和 id -g 的值
# WWWUSER=1000
# WWWGROUP=1000
